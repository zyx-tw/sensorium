# Copy to .env and fill in the blanks. Docker Compose (compose.yaml) reads it,
# and so does a run from source.

# --- Docker Compose ---------------------------------------------------------

# The image tag compose.yaml runs: a release such as 0.1.0, or latest.
SENSORIUM_VERSION=latest

# The password of the bundled Postgres. compose.yaml puts it into DATABASE_URL
# as it is, so keep it URL-safe: `openssl rand -hex 32`. DATABASE_URL below
# only matters for a run from source.
POSTGRES_PASSWORD=
# PostgreSQL cache. About a quarter of the host's memory; effective_cache_size about half.
# POSTGRES_SHARED_BUFFERS=512MB
# POSTGRES_EFFECTIVE_CACHE_SIZE=1536MB

# PostgreSQL image. 16 by default; read deploy/README.md before changing it on an existing volume.
# SENSORIUM_POSTGRES_IMAGE=postgres:18-alpine

# Where compose.yaml publishes the two ports. 127.0.0.1 keeps them for a
# reverse proxy on the same machine; 0.0.0.0 exposes plain HTTP to the network.
SENSORIUM_BIND=127.0.0.1
SENSORIUM_INGEST_PORT=8787
SENSORIUM_MCP_PORT=8788

# --- Every run --------------------------------------------------------------

# Who may read /mcp: a static bearer token, OAuth access tokens from an
# OpenID Connect issuer, or both (set at least one).
#
# The static token is one shared secret every trusted reader sends.
# Generate one with `openssl rand -hex 32`.
SENSORIUM_MCP_TOKEN=
# OAuth: sensorium checks the token as a resource server (signature, issuer,
# audience = SENSORIUM_MCP_RESOURCE, an access token, `azp` in
# SENSORIUM_MCP_OIDC_CLIENT_IDS, and the realm role SENSORIUM_MCP_OIDC_ROLE when
# set) and serves /.well-known/oauth-protected-resource/mcp naming the issuer,
# so MCP clients sign in there. The issuer must put SENSORIUM_MCP_RESOURCE in
# the token audience (an audience mapper in Keycloak).
SENSORIUM_MCP_OIDC_ISSUER=
SENSORIUM_MCP_RESOURCE=
SENSORIUM_MCP_OIDC_CLIENT_IDS=
SENSORIUM_MCP_OIDC_ROLE=

# Retention, applied by the retention sweep (the retention service in
# compose.yaml, or the systemd timer in deploy/). Metrics expire by dropping
# whole day partitions; spans and logs by DELETE. Size the metric window
# against throughput, not intuition: one busy Proxmox host writes ~2.4GB of
# metrics a day, so 14 days is ~33GB on disk. AHEAD_DAYS is how far ahead
# partitions are created, the slack the system has if the sweep stops.
SENSORIUM_RETENTION_METRIC_DAYS=14
# 5-minute metric rollups (count, sum, min, max, last per series) outlive raw points.
SENSORIUM_RETENTION_ROLLUP_DAYS=90
SENSORIUM_RETENTION_SPAN_DAYS=30
SENSORIUM_RETENTION_LOG_DAYS=30
SENSORIUM_RETENTION_AHEAD_DAYS=7

# --- A run from source ------------------------------------------------------

# Shared by apps/ingest, apps/mcp and packages/db (migration runner / CLI).
DATABASE_URL=postgres://user:password@localhost:5432/sensorium

# HTTP ports of the OTLP/HTTP receiver (apps/ingest) and the MCP endpoint
# (apps/mcp). compose.yaml sets its own.
PORT=8787
MCP_PORT=8788

# --- Optional ---------------------------------------------------------------

# 1 serves sensorium.zyx.tw's landing page at / (and /index.md). It carries
# zyx.tw's frame and links, so leave it unset on any other instance, which then
# answers / with a 404.
SENSORIUM_LANDING=

# Comma-separated metric names that ingest discards before they reach the
# database; `*` matches any run of characters. Use it for producers that send
# everything with no filter of their own, such as Proxmox's built-in OTel
# server: `proxmox_vm_*` drops the per-guest metrics, about 3/4 of its volume.
SENSORIUM_METRIC_DROP=

# Ingest limits. A body larger than SENSORIUM_INGEST_MAX_BODY_BYTES (default
# 67108864, 64 MiB, also measured after gzip decompression) gets a 413; more
# than SENSORIUM_INGEST_MAX_IN_FLIGHT exports at once (default 32) get a 429,
# which exporters retry.
SENSORIUM_INGEST_MAX_BODY_BYTES=
SENSORIUM_INGEST_MAX_IN_FLIGHT=

# Per-project ingest tokens are NOT env vars: `register-project <name>` prints
# one once (only its sha256 hash is stored in `projects`), and running it again
# for the same name rotates it. Producers send it as
# `Authorization: Bearer <token>`, or a Collector running collector/config.yaml
# forwards it on their behalf from SENSORIUM_INGEST_TOKEN:
SENSORIUM_INGEST_TOKEN=
