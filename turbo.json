{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "globalEnv": ["DATABASE_URL", "PORT", "MCP_PORT", "SENSORIUM_MCP_TOKEN", "SENSORIUM_MCP_OIDC_ISSUER", "SENSORIUM_MCP_RESOURCE", "SENSORIUM_MCP_OIDC_CLIENT_IDS", "SENSORIUM_MCP_OIDC_ROLE", "SENSORIUM_LANDING", "SENSORIUM_METRIC_DROP", "SENSORIUM_INGEST_MAX_BODY_BYTES", "SENSORIUM_INGEST_MAX_IN_FLIGHT"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["dist/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
