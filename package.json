{
  "name": "sensorium",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write \"**/*.{ts,md}\"",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:migrate": "bun run packages/db/src/cli.ts migrate",
    "db:register-project": "bun run packages/db/src/cli.ts register-project",
    "db:retention": "bun run packages/db/src/cli.ts retention"
  },
  "devDependencies": {
    "@sensorium/eslint-config": "workspace:*",
    "@types/bun": "^1.4.5",
    "eslint": "^10.15.0",
    "prettier": "^3.10.1",
    "turbo": "^2.11.13",
    "typescript": "6.0.3"
  },
  "engines": {
    "node": ">=18"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.4.5"
    }
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
